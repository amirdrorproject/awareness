# Copy to .env (Next.js also reads .env.local) and fill in. Never commit real values.

# Claude - used by the LangGraph flow and by /api/chat
ANTHROPIC_API_KEY=

# Pinecone - retrieval for the expression banks and success-story analysis
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Supabase
# Postgres connection string - LangGraph conversation state (checkpointer)
SUPABASE_DB_URL=
# Project URL and secret key - editable system prompt (/api/admin/system-prompt)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Keystatic (GitHub mode) - content editing UI at /keystatic
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
